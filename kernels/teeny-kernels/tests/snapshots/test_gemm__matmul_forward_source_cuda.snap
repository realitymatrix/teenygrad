"pub fn matmul_forward < T : Triton < I32Tensor = < T as Triton > :: Tensor <\ni32 > > , D : Num, const BLOCK_M : i32, const BLOCK_N : i32, const BLOCK_K :\ni32, const GROUP_M : i32, >\n(a_ptr : T :: Pointer < D > , b_ptr : T :: Pointer < D > , c_ptr : T ::\nPointer < D > , M : i32, N : i32, K : i32, A_BATCH_ROWS : i32, B_BATCH_ROWS :\ni32, FULL_TILES : i32, TAIL_OFF : i32, TAIL_KEEP_FROM : i32,) where T ::\nI32Tensor : core :: ops :: Add < i32, Output = T :: I32Tensor > , T ::\nI32Tensor : core :: ops :: Sub < i32, Output = T :: I32Tensor > ,\n{\n    let pid = T :: program_id(Axis :: X); let pid_b = T ::\n    program_id(Axis :: Y); let a_row0 = pid_b * A_BATCH_ROWS; let b_row0 =\n    pid_b * B_BATCH_ROWS; let c_row0 = pid_b * M; let num_pid_m = T ::\n    cdiv(M, BLOCK_M); let num_pid_n = T :: cdiv(N, BLOCK_N); let\n    num_pid_in_group = GROUP_M * num_pid_n; let group_id = pid /\n    num_pid_in_group; let first_pid_m = group_id * GROUP_M; let remaining_m =\n    num_pid_m - first_pid_m; let group_size_m = if remaining_m < GROUP_M\n    { remaining_m } else { GROUP_M }; let pid_in_group = pid %\n    num_pid_in_group; let pid_m = first_pid_m + (pid_in_group % group_size_m);\n    let pid_n = pid_in_group / group_size_m; let a_desc = T ::\n    make_tensor_descriptor(a_ptr, & [a_row0 + M, K], & [K, 1], &\n    [BLOCK_M, BLOCK_K], Some(PaddingOption :: Zero),); let b_desc = T ::\n    make_tensor_descriptor(b_ptr, & [b_row0 + K, N], & [N, 1], &\n    [BLOCK_K, BLOCK_N], Some(PaddingOption :: Zero),); let mut acc = T ::\n    zeros :: < D > (& [BLOCK_M, BLOCK_N]); for k in 0 .. FULL_TILES\n    {\n        let a = T ::\n        load_tensor_descriptor(a_desc, &\n        [a_row0 + pid_m * BLOCK_M, k * BLOCK_K]); let b = T ::\n        load_tensor_descriptor(b_desc, &\n        [b_row0 + k * BLOCK_K, pid_n * BLOCK_N]); acc = T :: dot :: < D, D >\n        (a, b, Some(acc), InputPrecision :: TF32, None);\n    } let lane = T :: arange(0, BLOCK_K); let keep = T ::\n    maximum(T ::\n    minimum(lane - TAIL_KEEP_FROM + 1, T :: full :: < i32 > (& [BLOCK_K], 1)),\n    T :: full :: < i32 > (& [BLOCK_K], 0),); let keep_d = T ::\n    broadcast_to(T ::\n    expand_dims(T :: cast :: < i32, D > (keep, None, false), 0), &\n    [BLOCK_M, BLOCK_K],); let a_tail = T ::\n    load_tensor_descriptor(a_desc, & [a_row0 + pid_m * BLOCK_M, TAIL_OFF]);\n    let b_tail = T ::\n    load_tensor_descriptor(b_desc, & [b_row0 + TAIL_OFF, pid_n * BLOCK_N]);\n    acc = T :: dot :: < D, D >\n    (a_tail * keep_d, b_tail, Some(acc), InputPrecision :: TF32, None); let\n    c_desc = T ::\n    make_tensor_descriptor(c_ptr, & [c_row0 + M, N], & [N, 1], &\n    [BLOCK_M, BLOCK_N], Some(PaddingOption :: Zero),); T ::\n    store_tensor_descriptor(c_desc, &\n    [c_row0 + pid_m * BLOCK_M, pid_n * BLOCK_N], acc);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn matmul_forward_entry_point(a_ptr: *mut f32, b_ptr: *mut f32, c_ptr: *mut f32, M: i32, N: i32, K: i32, A_BATCH_ROWS: i32, B_BATCH_ROWS: i32, FULL_TILES: i32, TAIL_OFF: i32, TAIL_KEEP_FROM: i32) {\n    let a_ptr = LlvmPointer(a_ptr as *mut _);\n    let b_ptr = LlvmPointer(b_ptr as *mut _);\n    let c_ptr = LlvmPointer(c_ptr as *mut _);\n    matmul_forward::<LlvmTriton, f32, 32, 32, 32, 8>(a_ptr, b_ptr, c_ptr, M, N, K, A_BATCH_ROWS, B_BATCH_ROWS, FULL_TILES, TAIL_OFF, TAIL_KEEP_FROM);\n}"
