"pub fn avgpool2d_forward < T : Triton < I32Tensor = < T as Triton > :: Tensor\n< i32 > > , D : Num, const KH : i32, const KW : i32, const STRIDE_H : i32,\nconst STRIDE_W : i32, const PAD_H : i32, const PAD_W : i32, const\nCOUNT_INCLUDE_PAD : i32, const BLOCK_OW : i32, >\n(input_ptr : T :: Pointer < D > , output_ptr : T :: Pointer < D > , _B : i32,\nC : i32, H : i32, W : i32, OH : i32, OW : i32,) where T :: I32Tensor : Tensor\n< i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor >\n, T :: I32Tensor : core :: ops :: Add < i32, Output = T :: I32Tensor > , T ::\nI32Tensor : core :: ops :: Sub < i32, Output = T :: I32Tensor > , T ::\nI32Tensor : core :: ops :: Mul < i32, Output = T :: I32Tensor > , T ::\nI32Tensor : core :: ops :: Add < T :: I32Tensor, Output = T :: I32Tensor > , T\n:: I32Tensor : core :: ops :: Sub < T :: I32Tensor, Output = T :: I32Tensor >\n, T :: I32Tensor : core :: ops :: Mul < T :: I32Tensor, Output = T ::\nI32Tensor > , T :: Pointer < D > : AddOffsets < i32, 1, T :: I32Tensor, Output\n= T :: Tensor < T :: Pointer < D > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let num_ow_tiles = T ::\n    cdiv(OW, BLOCK_OW); let ow_tile = pid % num_ow_tiles; let bco = pid /\n    num_ow_tiles; let oh = bco % OH; let bc = bco / OH; let c = bc % C; let b\n    = bc / C; let ow_start = ow_tile * BLOCK_OW; let ow_range = T ::\n    arange(0, BLOCK_OW) + ow_start; let ow_mask = ow_range.lt(OW); let\n    in_bc_base = (b * C + c) * H * W; let out_bc_base = (b * C + c) * OH * OW;\n    let mut acc = T :: zeros :: < D > (& [BLOCK_OW]); let loop_bound = KH *\n    KW; for idx in 0 .. loop_bound\n    {\n        let kw = idx % KW; let kh = idx / KW; let ih = oh * STRIDE_H + kh -\n        PAD_H; let iw_range = ow_range * STRIDE_W + kw - PAD_W; let ih_i = T\n        :: full :: < i32 > (& [BLOCK_OW], ih); let row_valid = ih_i.ge(0) &\n        ih_i.lt(H); let col_valid = iw_range.ge(0) & iw_range.lt(W); let mask\n        = ow_mask & row_valid & col_valid; let in_offsets = iw_range +\n        (in_bc_base + ih * W); let tile = T ::\n        load(input_ptr.add_offsets(in_offsets), Some(mask),\n        Some(T :: zeros :: < D > (& [BLOCK_OW])), & [], None, None, None,\n        false,); acc = acc + tile;\n    } let cols = T ::\n    maximum(T ::\n    minimum(ow_range * STRIDE_W - PAD_W + KW, T :: full :: < i32 >\n    (& [BLOCK_OW], W),) - T ::\n    maximum(ow_range * STRIDE_W - PAD_W, T :: full :: < i32 >\n    (& [BLOCK_OW], 0),), T :: full :: < i32 > (& [BLOCK_OW], 0),); let rows =\n    T ::\n    maximum(T ::\n    minimum(T :: full :: < i32 > (& [BLOCK_OW], oh * STRIDE_H - PAD_H + KH), T\n    :: full :: < i32 > (& [BLOCK_OW], H),) - T ::\n    maximum(T :: full :: < i32 > (& [BLOCK_OW], oh * STRIDE_H - PAD_H), T ::\n    full :: < i32 > (& [BLOCK_OW], 0),), T :: full :: < i32 >\n    (& [BLOCK_OW], 0),); let denom_i = rows * cols * (1 - COUNT_INCLUDE_PAD) +\n    T :: full :: < i32 > (& [BLOCK_OW], KH * KW * COUNT_INCLUDE_PAD); let\n    denom = T :: cast :: < i32, D >\n    (T :: maximum(denom_i, T :: full :: < i32 > (& [BLOCK_OW], 1)), None,\n    false,); let result = acc / denom; let out_offsets = ow_range +\n    (out_bc_base + oh * OW); T ::\n    store(output_ptr.add_offsets(out_offsets), result, Some(ow_mask), & [],\n    None, None,);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn avgpool2d_forward_entry_point(input_ptr: *mut f32, output_ptr: *mut f32, _B: i32, C: i32, H: i32, W: i32, OH: i32, OW: i32) {\n    let input_ptr = LlvmPointer(input_ptr as *mut _);\n    let output_ptr = LlvmPointer(output_ptr as *mut _);\n    avgpool2d_forward::<LlvmTriton, f32, 2, 2, 2, 2, 0, 0, 1, 4>(input_ptr, output_ptr, _B, C, H, W, OH, OW);\n}"
